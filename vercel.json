{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'no build'",
  "ignoreCommand": "exit 1",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60,
      "externalPackages": ["@modelcontextprotocol/sdk", "zod", "redis", "jose", "@vercel/kv", "@vercel/mcp-adapter"]
    },
    "api/auth/login.ts": { "maxDuration": 30 },
    "api/auth/callback.ts": { "maxDuration": 30 },
    "api/auth/profile.ts": { "maxDuration": 15 },
    "api/auth/logout.ts": { "maxDuration": 15 },
    "api/auth/refresh.ts": { "maxDuration": 30 },
    "api/auth/revoke.ts": { "maxDuration": 30 },
    "api/index.ts": { "maxDuration": 10 },
    "api/dashboard.ts": { "maxDuration": 15 },
    "api/test-auth.ts": { "maxDuration": 15 },
    "api/upload-video.js": { "maxDuration": 60 },
    "api/upload-image.js": { "maxDuration": 60 },
    "api/create-creative.js": { "maxDuration": 30 },
    "api/create-adset.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/dashboard", "destination": "/api/dashboard" }
  ]
}
